params.outdir = '/mnt/workflow/pubdir'

report {
    enabled = true
    file = '/mnt/workflow/output/rfd4-execution-report.html'
}
timeline {
    enabled = true
    file = '/mnt/workflow/output/rfd4-timeline.html'
}
trace {
    enabled = true
    file = '/mnt/workflow/output/rfd4-trace.tsv'
}


// GPU selection for the generation tasks. main.nf adds the label generation_single when
// --generation_fallback_accelerator is unset (one accelerator type, the workflow never switches
// GPUs) and generation_fallback when it is set: HealthOmics then tries the preferred type first
// and advances to the fallback type if capacity is not reserved within the wait window
// (omicsResourceFallbackOrder). cpus and memory are inherited from the process directives.
// Only list GPU types on which the workload (token count x batch_size) has been qualified: an
// out-of-memory failure is retried within the active profile and never advances to the next one.
process {
    withLabel: 'generation_single' {
        accelerator = [request: 1, type: params.generation_accelerator]
    }
    withLabel: 'generation_fallback' {
        omicsResourceFallbackOrder = [
            [acceleratorType: params.generation_accelerator, acceleratorCount: 1,
             omicsResourceWaitTimeoutInMin: params.generation_wait_minutes.toInteger()],
            [acceleratorType: params.generation_fallback_accelerator, acceleratorCount: 1]
        ]
    }
}
